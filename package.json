{
  "name": "typeflow-apple-typing-tutor",
  "version": "1.0.0",
  "description": "Learn touch typing with guided lessons and live finger guidance.",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/regression.mjs && node tests/storage.mjs && node tests/practice.mjs && node tests/peripherals.mjs && node tests/content.mjs && node tests/learning.mjs && node tests/progress.mjs",
    "e2e": "playwright test",
    "format:check": "prettier --check \"**/*.jsx\" \"**/*.svg\"",
    "audit": "node docs/quality/run-lighthouse.mjs"
  },
  "keywords": [
    "touch-typing",
    "typing-tutor",
    "web-audio"
  ],
  "author": "o1tean",
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "3.9.9",
    "vite": "^8.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/o1tean/apple-typing-tutor.git"
  },
  "homepage": "https://o1tean.github.io/apple-typing-tutor/",
  "bugs": {
    "url": "https://github.com/o1tean/apple-typing-tutor/issues"
  }
}
